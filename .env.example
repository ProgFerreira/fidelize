DATABASE_URL="mysql://root@localhost:3306/fidelize"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Clube de Benefícios Dermaphios"
CRON_SECRET="change-me-cron-secret"

# Observabilidade (opcional — Sentry DSN)
# SENTRY_DSN=

# E-mail (Resend)
# RESEND_API_KEY=
# EMAIL_FROM="Clube <noreply@sua-clinica.com.br>"

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM="+5511..."

# WhatsApp Cloud API (Meta)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=fidelize-verify

# Push FCM HTTP v1 (recomendado)
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","project_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Push legacy (deprecated)
# FCM_SERVER_KEY=

# OCR de comprovantes (OCR.space)
# OCR_API_KEY=

# Billing futuro (opcional)
# ASAAS_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
