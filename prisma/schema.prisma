model Organization {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  tradeName        String?
  document         String?   @unique
  plan             String    @default("trial")
  active           Boolean   @default(true)
  suspendedAt      DateTime?
  suspensionReason String?   @db.Text
  trialEndsAt      DateTime?
  maxUsers         Int?
  maxClinics       Int?
  maxPatients      Int?
  contactEmail     String?
  contactPhone     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  clinics            Clinic[]
  users              User[]
  platformAccesses   PlatformAccess[]
  affiliateReferrals AffiliateReferral[]
  platformSales      PlatformSale[]
  invoices           OrganizationInvoice[]

  @@index([active])
  @@index([deletedAt])
}

enum OrganizationInvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

model OrganizationInvoice {
  id             String                     @id @default(cuid())
  organizationId String
  planCode       String
  amount         Decimal                    @db.Decimal(19, 4)
  status         OrganizationInvoiceStatus  @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  notes          String?                    @db.Text
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([status, periodEnd])
}

model PlatformAccess {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  reason         String    @db.Text
  ip             String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, startedAt])
  @@index([userId])
}

model Clinic {
  id             String   @id @default(cuid())
  organizationId String?
  slug           String?
  customDomain   String?
  name      String
  tradeName String?
  document  String?
  email     String?
  phone     String?
  logoUrl   String?
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization? @relation(fields: [organizationId], references: [id])
  units                 Unit[]
  users                 User[]
  roles                 Role[]
  patients              Patient[]
  wallets               Wallet[]
  cards                 Card[]
  categories            Category[]
  procedures            Procedure[]
  professionals         Professional[]
  appointments          Appointment[]
  appointmentItems      AppointmentItem[]
  scheduleEvents        ScheduleEvent[]
  payments              Payment[]
  ledgerEntries         LedgerEntry[]
  creditLots            CreditLot[]
  redemptions           Redemption[]
  campaigns             Campaign[]
  coupons               Coupon[]
  settings              Setting[]
  auditLogs             AuditLog[]
  notificationTemplates NotificationTemplate[]
  idempotencyKeys       IdempotencyKey[]
  patientOtps           PatientOtp[]
  featureModules        FeatureModule[]
  moduleConfigurations  ModuleConfiguration[]
  onboardingChecklists  OnboardingChecklist[]
  customerTags          CustomerTag[]
  dynamicSegments       DynamicSegment[]
  automations           Automation[]
  messageTemplates      MessageTemplate[]
  communications        Communication[]
  consentRecords        ConsentRecord[]
  communicationPreferences CommunicationPreference[]
  referralPrograms      ReferralProgram[]
  referrals             Referral[]
  satisfactionSurveys   SatisfactionSurvey[]
  recoveryCases         RecoveryCase[]
  rewards               Reward[]
  vouchers              Voucher[]
  giftCards             GiftCard[]
  acceleratorRules      AcceleratorRule[]
  campaignAttributions  CampaignAttribution[]
  apiCredentials        ApiCredential[]
  webhookEndpoints      WebhookEndpoint[]
  integrationLogs       IntegrationLog[]
  pushDevices           PushDevice[]
  receiptSubmissions    ReceiptSubmission[]
  raffles               Raffle[]
  predictionScores      PredictionScore[]
  revenueForecasts      RevenueForecast[]
  widgetOrigins         WidgetOrigin[]
  mobileSessions        MobileSession[]
  videoCallRooms        VideoCallRoom[]
  treatmentPackages     TreatmentPackage[]
  membershipPlans       MembershipPlan[]
  memberships           PatientMembership[]
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, active])
  @@index([customDomain])
}

model Unit {
  id        String   @id @default(cuid())
  organizationId String?
  clinicId  String
  name      String
  code      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patients       Patient[]
  users          User[]
  appointments   Appointment[]
  scheduleEvents ScheduleEvent[]
  professionals  Professional[]
  cards          Card[]
  campaigns      CampaignUnit[]

  @@unique([clinicId, code])
  @@index([clinicId, active])
  @@index([organizationId])
}

model Role {
  id          String   @id @default(cuid())
  organizationId String?
  clinicId    String?
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic?           @relation(fields: [clinicId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([clinicId, code])
  @@index([code])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String     @id @default(cuid())
  organizationId String?
  clinicId       String?
  unitId         String?
  roleId         String
  name           String
  email          String
  passwordHash   String
  phone          String?
  status         UserStatus @default(ACTIVE)
  mfaEnabled     Boolean    @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?
  resetToken     String?
  resetExpiresAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization     Organization?   @relation(fields: [organizationId], references: [id])
  clinic           Clinic?         @relation(fields: [clinicId], references: [id])
  unit             Unit?           @relation(fields: [unitId], references: [id])
  role             Role            @relation(fields: [roleId], references: [id])
  accounts         Account[]
  sessions         Session[]
  auditLogs        AuditLog[]
  appointments     Appointment[]   @relation("AppointmentOperator")
  scheduleEvents   ScheduleEvent[] @relation("ScheduleEventCreator")
  ledgerEntries    LedgerEntry[]   @relation("LedgerOperator")
  redemptions      Redemption[]
  platformAccesses PlatformAccess[]
  affiliateProfile Affiliate?
  videoCallRoomsCreated      VideoCallRoom[]           @relation("VideoCallRoomCreator")
  videoCallRecordingsCreated VideoCallRecording[]      @relation("VideoCallRecordingCreator")
  videoCallChatTranscriptsCreated VideoCallChatTranscript[] @relation("VideoCallChatTranscriptCreator")
  videoCallAudioTranscriptsCreated VideoCallAudioTranscript[] @relation("VideoCallAudioTranscriptCreator")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([clinicId, status])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * Idempotência de webhooks recebidos de provedores externos (ex.: Meta
 * WhatsApp). Sem organizationId de propósito: a checagem de duplicidade
 * precisa acontecer antes de sabermos a qual clínica o evento pertence.
 */
model InboundWebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  receivedAt DateTime @default(now())

  @@unique([provider, externalId])
}

model Patient {
  id                String        @id @default(cuid())
  organizationId String?
  clinicId          String
  unitId            String?
  fullName          String
  cpf               String
  birthDate         DateTime?     @db.Date
  phone             String
  email             String?
  gender            String?
  address           String?       @db.Text
  externalCode      String?
  status            PatientStatus @default(ACTIVE)
  commercialNotes   String?       @db.Text
  regulationConsent Boolean       @default(false)
  marketingConsent  Boolean       @default(false)
  holderPatientId   String?
  bookingBlockedUntil DateTime?
  noShowCount       Int           @default(0)
  registeredAt      DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])
  consents      Consent[]
  wallets       Wallet[]
  appointments  Appointment[]
  scheduleEvents ScheduleEvent[]
  patientOtps   PatientOtp[]
  campaignUses  CampaignUse[]
  tagAssignments CustomerTagAssignment[]
  consentRecords ConsentRecord[]
  communicationPreferences CommunicationPreference[]
  communications Communication[]
  referralsMade  Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")
  surveyResponses SurveyResponse[]
  recoveryCases  RecoveryCase[]
  rewardRedemptions RewardRedemption[]
  voucherRedemptions VoucherRedemption[]
  giftCardsBought GiftCard[] @relation("GiftCardBuyer")
  giftCardsReceived GiftCard[] @relation("GiftCardBeneficiary")
  campaignAttributions CampaignAttribution[]
  automationExecutions AutomationExecution[]
  pushDevices PushDevice[]
  receiptSubmissions ReceiptSubmission[]
  raffleTickets RaffleTicket[]
  predictionScores PredictionScore[]
  mobileSessions MobileSession[]
  videoCallRooms VideoCallRoom[]
  treatmentPackages TreatmentPackage[]
  holder         Patient?       @relation("PatientFamily", fields: [holderPatientId], references: [id], onDelete: SetNull)
  dependents     Patient[]      @relation("PatientFamily")
  memberships    PatientMembership[]

  @@unique([clinicId, cpf])
  @@index([clinicId, phone])
  @@index([clinicId, externalCode])
  @@index([clinicId, status])
  @@index([clinicId, fullName])
  @@index([clinicId, birthDate])
  @@index([holderPatientId])
  @@index([organizationId])
}

model Consent {
  id        String   @id @default(cuid())
  organizationId String?
  clinicId  String
  patientId String
  type      String
  accepted  Boolean
  version   String?
  ipAddress String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, type])
  @@index([organizationId])
}

model Category {
  id               String          @id @default(cuid())
  organizationId String?
  clinicId         String
  name             String
  slug             String
  color            String
  icon             String?
  minAnnualSpend   Decimal         @default(0) @db.Decimal(19, 4)
  minPoints        Int             @default(0)
  minAppointments  Int             @default(0)
  cashbackPercent  Decimal         @default(0) @db.Decimal(8, 4)
  discountPercent  Decimal         @default(0) @db.Decimal(8, 4)
  benefits         String?         @db.Text
  sortOrder        Int             @default(0)
  progressionMode  ProgressionMode @default(SPEND)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  wallets Wallet[]

  @@unique([clinicId, slug])
  @@index([clinicId, active, sortOrder])
  @@index([organizationId])
}

model Wallet {
  id                 String       @id @default(cuid())
  organizationId String?
  clinicId           String
  patientId          String
  categoryId         String?
  status             WalletStatus @default(ACTIVE)
  availableBalance   Decimal      @default(0) @db.Decimal(19, 4)
  pendingBalance     Decimal      @default(0) @db.Decimal(19, 4)
  pointsBalance      Int          @default(0)
  annualSpend        Decimal      @default(0) @db.Decimal(19, 4)
  appointmentCount   Int          @default(0)
  version            Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  cards         Card[]
  ledgerEntries LedgerEntry[]
  creditLots    CreditLot[]
  redemptions   Redemption[]
  appointments  Appointment[]

  @@unique([clinicId, patientId])
  @@index([clinicId, status])
  @@index([categoryId])
  @@index([organizationId])
}

model Card {
  id           String     @id @default(cuid())
  organizationId String?
  clinicId     String
  unitId       String?
  walletId     String?
  publicToken  String     @unique
  cardNumber   String
  kind         CardKind   @default(PHYSICAL)
  status       CardStatus @default(AVAILABLE)
  expiresAt    DateTime?
  linkedAt     DateTime?
  blockedAt    DateTime?
  blockedReason String?
  replacedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clinic Clinic  @relation(fields: [clinicId], references: [id])
  unit   Unit?   @relation(fields: [unitId], references: [id])
  wallet Wallet? @relation(fields: [walletId], references: [id])

  @@unique([clinicId, cardNumber])
  @@index([clinicId, status])
  @@index([clinicId, kind, status])
  @@index([walletId])
  @@index([organizationId])
}

model Procedure {
  id              String   @id @default(cuid())
  organizationId String?
  clinicId        String
  code            String
  name            String
  description     String?  @db.Text
  /** Foto do serviço/produto (URL pública ou path em /uploads). */
  imageUrl        String?
  basePrice       Decimal  @default(0) @db.Decimal(19, 4)
  /** Preço de tabela (“De”) para exibir promoção; venda real é basePrice (“Por”). */
  compareAtPrice  Decimal? @db.Decimal(19, 4)
  /** Validade do serviço/produto em dias após a venda ou realização. */
  validityDays    Int?
  /** Intervalo sugerido para retorno (régua WhatsApp 30/7/1 dia antes). */
  intervaloRetornoDias Int?
  /** Se >= 2, a venda no PDV emite um pacote com N sessões. */
  packageSessions Int?
  stockQty        Int?
  stockAlertAt    Int?
  /** Duração típica do atendimento em minutos (agenda / PDV). */
  durationMinutes Int?     @default(60)
  cashbackPercent Decimal? @db.Decimal(8, 4)
  pointsPerReal   Decimal? @db.Decimal(8, 4)
  eligible        Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]
  appointmentItems AppointmentItem[]
  scheduleEvents ScheduleEvent[]
  professionalLinks ProfessionalProcedure[]
  campaigns      CampaignProcedure[]
  treatmentPackages TreatmentPackage[]

  @@unique([clinicId, code])
  @@index([clinicId, active])
  @@index([clinicId, name])
  @@index([organizationId])
}

model Professional {
  id             String   @id @default(cuid())
  organizationId String?
  clinicId       String
  unitId         String?
  name           String
  /** O que o profissional faz (especialidade / função). */
  specialty      String
  notes          String?  @db.Text
  active         Boolean  @default(true)
  color          String?
  commissionPercent Decimal? @db.Decimal(8, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clinic         Clinic                   @relation(fields: [clinicId], references: [id])
  unit           Unit?                    @relation(fields: [unitId], references: [id])
  procedures     ProfessionalProcedure[]
  scheduleEvents ScheduleEvent[]

  @@index([clinicId, active])
  @@index([clinicId, name])
  @@index([organizationId])
}

model ProfessionalProcedure {
  professionalId String
  procedureId    String
  /** Preço deste profissional para o serviço; null = usa Procedure.basePrice. */
  price          Decimal? @db.Decimal(19, 4)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  procedure    Procedure    @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@id([professionalId, procedureId])
  @@index([procedureId])
}

model ScheduleEvent {
  id               String              @id @default(cuid())
  organizationId   String?
  clinicId         String
  unitId           String?
  patientId        String?
  procedureId      String?
  professionalId   String?
  createdById      String?
  title            String
  startsAt         DateTime
  endsAt           DateTime
  status           ScheduleEventStatus @default(SCHEDULED)
  professionalName String?
  notes            String?             @db.Text
  color            String?
  depositAmount    Decimal?            @db.Decimal(19, 4)
  depositMethod    String?
  depositStatus    String?
  depositLedgerId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  procedure    Procedure?    @relation(fields: [procedureId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  createdBy    User?         @relation("ScheduleEventCreator", fields: [createdById], references: [id])
  videoCallRoom VideoCallRoom?
  packageUses  TreatmentPackageUse[]

  @@index([clinicId, startsAt])
