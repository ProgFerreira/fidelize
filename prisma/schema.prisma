  commissionPlan AffiliateCommissionPlan  @relation(fields: [commissionPlanId], references: [id])
  visits         AffiliateVisit[]
  referrals      AffiliateReferral[]
  commissions    AffiliateCommission[]
  payouts        AffiliatePayout[]

  @@index([status])
  @@index([type, status])
  @@index([email])
  @@index([document])
}

model AffiliateVisit {
  id           String   @id @default(cuid())
  affiliateId  String
  code         String
  visitToken   String
  landingPath  String?
  referer      String?  @db.Text
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  ipHash       String?
  userAgent    String?  @db.Text
  expiresAt    DateTime
  organizationId String?
  createdAt    DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, createdAt])
  @@index([visitToken])
  @@index([code, createdAt])
  @@index([expiresAt])
}

model AffiliateReferral {
  id             String                  @id @default(cuid())
  affiliateId    String
  organizationId String
  visitId        String?
  source         AffiliateReferralSource @default(ADMIN)
  active         Boolean                 @default(true)
  linkedByUserId String?
  linkReason     String?                 @db.Text
  previousAffiliateId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  affiliate    Affiliate    @relation(fields: [affiliateId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  commissions  AffiliateCommission[]

  /// Preenchido com organizationId enquanto active=true; null quando inativo (unique parcial).
  activeOrganizationKey String? @unique

  @@index([affiliateId, createdAt])
  @@index([organizationId, active])
}

model PlatformSale {
  id               String             @id @default(cuid())
  organizationId   String
  planCode         String
  grossAmount      Decimal            @db.Decimal(19, 4)
  discountAmount   Decimal            @default(0) @db.Decimal(19, 4)
  netAmount        Decimal            @db.Decimal(19, 4)
  status           PlatformSaleStatus @default(PENDING)
  idempotencyKey   String             @unique
  notes            String?            @db.Text
  confirmedAt      DateTime?
  confirmedByUserId String?
  cancelledAt      DateTime?
  cancelReason     String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  commissions  AffiliateCommission[]

  @@index([organizationId, status])
  @@index([status, confirmedAt])
}

model AffiliateCommission {
  id              String                     @id @default(cuid())
  affiliateId     String
  referralId      String?
  platformSaleId  String
  kind            AffiliateCommissionKind    @default(PRIMARY)
  status          AffiliateCommissionStatus  @default(PENDING)
  baseAmount      Decimal                    @db.Decimal(19, 4)
  amount          Decimal                    @db.Decimal(19, 4)
  ruleSnapshot    Json
  availableAt     DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  cancelReason    String?                    @db.Text
  blockReason     String?                    @db.Text
  fraudFlags      Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  affiliate    Affiliate                   @relation(fields: [affiliateId], references: [id])
  referral     AffiliateReferral?          @relation(fields: [referralId], references: [id])
  platformSale PlatformSale                @relation(fields: [platformSaleId], references: [id])
  payoutItems  AffiliatePayoutItem[]

  @@unique([platformSaleId, kind])
  @@index([affiliateId, status])
  @@index([status, availableAt])
  @@index([referralId])
}

model AffiliatePayout {
  id              String                @id @default(cuid())
  affiliateId     String
  periodStart     DateTime?
  periodEnd       DateTime?
  totalAmount     Decimal               @db.Decimal(19, 4)
  status          AffiliatePayoutStatus @default(DRAFT)
  method          String?
  payoutKeyUsed   String?
  paidAt          DateTime?
  paidByUserId    String?
  notes           String?               @db.Text
  receiptPath     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  affiliate Affiliate             @relation(fields: [affiliateId], references: [id])
  items     AffiliatePayoutItem[]

  @@index([affiliateId, status])
  @@index([status, paidAt])
}

model AffiliatePayoutItem {
  id           String   @id @default(cuid())
  payoutId     String
  commissionId String
  amount       Decimal  @db.Decimal(19, 4)
  createdAt    DateTime @default(now())

  payout     AffiliatePayout     @relation(fields: [payoutId], references: [id])
  commission AffiliateCommission @relation(fields: [commissionId], references: [id])

  @@unique([payoutId, commissionId])
  @@index([commissionId])
}

model AffiliateAuditLog {
  id         String   @id @default(cuid())
  action     String
  actorUserId String?
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  reason     String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
