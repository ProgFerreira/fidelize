enum VideoCallStatus {
  CRIADA
  AGUARDANDO
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum VideoCallParticipantRole {
  PROFISSIONAL
  PACIENTE
}

model VideoCallRoom {
  id               String          @id @default(cuid())
  organizationId   String?
  clinicId         String
  scheduleEventId  String?         @unique
  patientId        String
  status           VideoCallStatus @default(CRIADA)
  patientConsentAt DateTime?
  staffConsentAt   DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  clinic        Clinic               @relation(fields: [clinicId], references: [id])
  scheduleEvent ScheduleEvent?       @relation(fields: [scheduleEventId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id])
  createdBy     User?                @relation("VideoCallRoomCreator", fields: [createdById], references: [id])
  signals       VideoCallSignal[]
  recordings    VideoCallRecording[]
  chatTranscripts VideoCallChatTranscript[]
  audioTranscripts VideoCallAudioTranscript[]

  @@index([clinicId, status])
  @@index([patientId])
  @@index([organizationId])
}

model VideoCallSignal {
  id             String                   @id @default(cuid())
  organizationId String?
  roomId         String
  fromRole       VideoCallParticipantRole
  type           String
  payload        Json
  createdAt      DateTime                 @default(now())

  room VideoCallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([organizationId])
}

model VideoCallRecording {
  id             String   @id @default(cuid())
  organizationId String?
  roomId         String
  clinicId       String
  filePath       String
  mimeType       String
  sizeBytes      Int
  status         String   @default("DISPONIVEL")
  createdById    String?
  createdAt      DateTime @default(now())

  room      VideoCallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("VideoCallRecordingCreator", fields: [createdById], references: [id])

  @@index([clinicId, createdAt])
  @@index([organizationId])
}

model VideoCallChatTranscript {
  id             String   @id @default(cuid())
  organizationId String?
  roomId         String
  clinicId       String
  filePath       String
  messageCount   Int
  createdById    String?
  createdAt      DateTime @default(now())

  room      VideoCallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("VideoCallChatTranscriptCreator", fields: [createdById], references: [id])

  @@index([clinicId, createdAt])
  @@index([organizationId])
}

/**
 * Texto da transcrição de áudio, gerado localmente no navegador do médico
 * (Whisper via WASM) e enviado só o resultado em texto — o áudio em si
 * nunca sai da máquina de quem grava. Guardado como texto, sem arquivo,
 * pra ficar barato e disponível no histórico do paciente.
 */
model VideoCallAudioTranscript {
  id              String   @id @default(cuid())
  organizationId  String?
  roomId          String
  clinicId        String
  text            String   @db.Text
  durationSeconds Int?
  createdById     String?
  createdAt       DateTime @default(now())

  room      VideoCallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("VideoCallAudioTranscriptCreator", fields: [createdById], references: [id])

  @@index([clinicId, createdAt])
  @@index([organizationId])
}

model Appointment {
  id               String            @id @default(cuid())
  organizationId String?
  clinicId         String
  unitId           String?
  patientId        String
  walletId         String
  procedureId      String?
  operatorId       String?
  professionalName String?
  status           AppointmentStatus @default(DRAFT)
  grossAmount      Decimal           @db.Decimal(19, 4)
  discountAmount   Decimal           @default(0) @db.Decimal(19, 4)
  benefitUsed      Decimal           @default(0) @db.Decimal(19, 4)
  paidAmount       Decimal           @default(0) @db.Decimal(19, 4)
  cashbackGenerated Decimal          @default(0) @db.Decimal(19, 4)
  pointsGenerated  Int               @default(0)
  idempotencyKey   String?
  notes            String?           @db.Text
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  procedure     Procedure?     @relation(fields: [procedureId], references: [id])
  operator      User?          @relation("AppointmentOperator", fields: [operatorId], references: [id])
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  redemptions   Redemption[]
  items         AppointmentItem[]
  treatmentPackages TreatmentPackage[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, occurredAt])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([walletId])
  @@index([organizationId])
}

model AppointmentItem {
  id               String   @id @default(cuid())
  organizationId   String?
  clinicId         String
  appointmentId    String
  procedureId      String?
  name             String
  unitPrice        Decimal  @db.Decimal(19, 4)
  quantity         Int      @default(1)
  lineTotal        Decimal  @db.Decimal(19, 4)
  professionalName String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  procedure   Procedure?  @relation(fields: [procedureId], references: [id])

  @@index([appointmentId])
  @@index([clinicId, procedureId])
  @@index([organizationId])
}

enum TreatmentPackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

/// Pacote de sessões vendido no PDV (ex.: 6 sessões de laser).
model TreatmentPackage {
  id                 String                  @id @default(cuid())
  organizationId     String?
  clinicId           String
  patientId          String
  procedureId        String
  appointmentId      String?
  totalSessions      Int
  remainingSessions  Int
  expiresAt          DateTime?
  status             TreatmentPackageStatus  @default(ACTIVE)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  clinic      Clinic                @relation(fields: [clinicId], references: [id])
  patient     Patient               @relation(fields: [patientId], references: [id])
  procedure   Procedure             @relation(fields: [procedureId], references: [id])
  appointment Appointment?          @relation(fields: [appointmentId], references: [id])
  uses        TreatmentPackageUse[]

  @@index([clinicId, patientId, status])
  @@index([clinicId, procedureId, status])
  @@index([organizationId])
}

model TreatmentPackageUse {
  id              String   @id @default(cuid())
  packageId       String
  scheduleEventId String?
  appointmentId   String?
  createdAt       DateTime @default(now())

  package       TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  scheduleEvent ScheduleEvent?   @relation(fields: [scheduleEventId], references: [id])

  @@unique([packageId, scheduleEventId])
  @@index([packageId, createdAt])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

model MembershipPlan {
  id                 String   @id @default(cuid())
  organizationId     String?
  clinicId           String
  name               String
  monthlyPrice       Decimal  @db.Decimal(19, 4)
  extraCashbackPct   Decimal  @default(0) @db.Decimal(8, 4)
  courtesyNote       String?  @db.Text
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  memberships  PatientMembership[]

  @@index([clinicId, active])
  @@index([organizationId])
}

model PatientMembership {
  id          String           @id @default(cuid())
  organizationId String?
  clinicId    String
  patientId   String
  planId      String
  status      MembershipStatus @default(PENDING)
  startedAt   DateTime         @default(now())
  renewsAt    DateTime
  paidMethod  String?
  paidAmount  Decimal?         @db.Decimal(19, 4)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  clinic  Clinic         @relation(fields: [clinicId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  plan    MembershipPlan @relation(fields: [planId], references: [id])

  @@index([clinicId, status])
  @@index([patientId, status])
  @@index([organizationId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String?
  clinicId       String
  appointmentId  String
  amount         Decimal       @db.Decimal(19, 4)
  method         String?
  status         PaymentStatus @default(PENDING)
  confirmedAt    DateTime?
  idempotencyKey String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status])
  @@index([appointmentId])
  @@index([organizationId])
}

model LedgerEntry {
  id              String       @id @default(cuid())
  organizationId String?
  clinicId        String
  unitId          String?
  patientId       String
  walletId        String
  type            LedgerType
  status          LedgerStatus @default(COMPLETED)
  amount          Decimal      @db.Decimal(19, 4)
  points          Int          @default(0)
  balanceBefore   Decimal      @db.Decimal(19, 4)
  balanceAfter    Decimal      @db.Decimal(19, 4)
  origin          String?
  appointmentId   String?
  campaignId      String?
  creditLotId     String?
  operatorId      String?
  originalEntryId String?
  expiresAt       DateTime?
  reason          String?
  metadata        Json?
  idempotencyKey  String?
  createdAt       DateTime     @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  operator    User?        @relation("LedgerOperator", fields: [operatorId], references: [id])
  creditLot   CreditLot?   @relation(fields: [creditLotId], references: [id])
  originalEntry LedgerEntry?  @relation("LedgerReversal", fields: [originalEntryId], references: [id])
  reversals     LedgerEntry[] @relation("LedgerReversal")
  redemptionItems RedemptionItem[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, createdAt])
  @@index([clinicId, type])
  @@index([walletId, createdAt])
  @@index([patientId, createdAt])
  @@index([originalEntryId])
  @@index([organizationId])
}

model CreditLot {
  id              String          @id @default(cuid())
  organizationId String?
  clinicId        String
  walletId        String
  appointmentId   String?
  campaignId      String?
  originalAmount  Decimal         @db.Decimal(19, 4)
  remainingAmount Decimal         @db.Decimal(19, 4)
  status          CreditLotStatus @default(PENDING)
  availableAt     DateTime
  expiresAt       DateTime?
  blockedReason   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  wallet          Wallet           @relation(fields: [walletId], references: [id])
  ledgerEntries   LedgerEntry[]
  redemptionItems RedemptionItem[]

  @@index([clinicId, status, expiresAt])
  @@index([walletId, status, expiresAt])
  @@index([status, availableAt])
  @@index([organizationId])
}

model Redemption {
  id             String   @id @default(cuid())
  organizationId String?
  clinicId       String
  walletId       String
  appointmentId  String?
  operatorId     String?
  amount         Decimal  @db.Decimal(19, 4)
  idempotencyKey String?
  createdAt      DateTime @default(now())

  clinic      Clinic           @relation(fields: [clinicId], references: [id])
  wallet      Wallet           @relation(fields: [walletId], references: [id])
  appointment Appointment?     @relation(fields: [appointmentId], references: [id])
  operator    User?            @relation(fields: [operatorId], references: [id])
  items       RedemptionItem[]

  @@unique([clinicId, idempotencyKey])
  @@index([walletId])
  @@index([appointmentId])
  @@index([organizationId])
}

model RedemptionItem {
  id            String  @id @default(cuid())
  redemptionId  String
  creditLotId   String
  ledgerEntryId String?
  amount        Decimal @db.Decimal(19, 4)

  redemption  Redemption   @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  creditLot   CreditLot    @relation(fields: [creditLotId], references: [id])
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  @@index([redemptionId])
  @@index([creditLotId])
}

model Campaign {
  id                 String         @id @default(cuid())
  organizationId String?
  clinicId           String
  name               String
  description        String?        @db.Text
  imageUrl           String?
  status             CampaignStatus @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  extraCashbackPct   Decimal        @default(0) @db.Decimal(8, 4)
  extraPoints        Int            @default(0)
  benefitDescription String?        @db.Text
  couponCode         String?
  totalLimit         Int?
  perPatientLimit    Int?           @default(1)
  segmentRules       Json?
  combineWithDiscount Boolean       @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  units        CampaignUnit[]
  procedures   CampaignProcedure[]
  coupons      Coupon[]
  uses         CampaignUse[]
  ledgerEntries LedgerEntry[]
  attributions CampaignAttribution[]

  @@index([clinicId, status])
  @@index([clinicId, startsAt, endsAt])
  @@index([organizationId])
}

model CampaignUnit {
  campaignId String
  unitId     String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([campaignId, unitId])
}

model CampaignProcedure {
  campaignId  String
  procedureId String

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@id([campaignId, procedureId])
}

model Coupon {
  id         String    @id @default(cuid())
  organizationId String?
  clinicId   String
  campaignId String?
  code       String
  active     Boolean   @default(true)
  maxUses    Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([clinicId, code])
  @@index([organizationId])
}

model CampaignUse {
  id         String   @id @default(cuid())
  campaignId String
  patientId  String
  usedAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([campaignId, patientId])
}

model Setting {
  id        String   @id @default(cuid())
  organizationId String?
  clinicId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, key])
  @@index([organizationId])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  organizationId String?
  clinicId  String
  key       String
  operation String
  response  Json?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, key])
  @@index([clinicId, operation])
  @@index([organizationId])
}

model AuditLog {
